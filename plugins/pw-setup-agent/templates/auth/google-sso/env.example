# Environment for the Playwright tests.
# Create your local copy with `{{ENV_INIT_CMD}}`, then fill in the empty values.
# .env is gitignored. Never commit real credentials.

# Application under test. BASE_URL may contain {ENVIRONMENT}
# (e.g. https://{ENVIRONMENT}.example.com), filled in from ENVIRONMENT.
{{ENV_PREFIX}}BASE_URL={{BASE_URL}}
{{ENV_PREFIX}}ENVIRONMENT=
{{ENV_PREFIX}}TEST_ENV=local

# Google accounts, one per role: <ROLE> is the account email. The password and
# OTP (a fixed 2-Step code) are optional; without them you finish signing in by
# hand in the Chrome window that opens.
{{ROLE_ENV}}
{{ENV_PREFIX}}OTP=

# Saved session (.auth/<role>.json): reused while younger than this many
# minutes and the who-am-I endpoint still returns 200 with it.
{{ENV_PREFIX}}AUTH_MAX_AGE_MINUTES=60
# Set to 1 to sign in again now (same as the login:force script).
{{ENV_PREFIX}}FORCE_LOGIN=

# Google Chrome used for signing in. Empty = the default install location.
{{ENV_PREFIX}}CHROME_PATH=
# Browser channel for the test projects, e.g. chrome. Empty = bundled Chromium.
{{ENV_PREFIX}}AUTH_BROWSER_CHANNEL=
