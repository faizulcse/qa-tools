# Environment for the Playwright tests.
# Create your local copy with `{{ENV_INIT_CMD}}`, then fill in the empty values.
# .env is gitignored. Never commit real credentials; on CI they come from
# GitHub secrets with the same names.

# Application under test
{{ENV_PREFIX}}BASE_URL={{BASE_URL}}
{{ENV_PREFIX}}TEST_ENV=local

# Role credentials: fill in locally
{{ROLE_ENV}}
