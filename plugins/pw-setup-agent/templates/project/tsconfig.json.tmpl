{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@pages/*": ["./{{PAGES_DIR}}/*"],
      "@fixtures": ["./fixtures/pages.fixture"],
      "@fixtures/*": ["./fixtures/*"],
      "@data/*": ["./test-data/*"],
      "@utils/*": ["./utils/*"]
    }
  },
  "include": [
    "playwright.config.ts",
    "{{SPECS_DIR}}/**/*.ts",
    "{{PAGES_DIR}}/**/*.ts",
    "fixtures/**/*.ts",
    "test-data/**/*.ts",
    "utils/**/*.ts"
  ],
  "exclude": ["node_modules", "test-results", "playwright-report", "blob-report"]
}
